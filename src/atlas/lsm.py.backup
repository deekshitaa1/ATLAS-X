from __future__ import annotations

import json
import threading
from pathlib import Path
from types import TracebackType
from typing import Any, ClassVar, Self

from atlas.bloom import BloomFilter

_NOT_FOUND = object()


class LSMTree:
    """
    Educational LSM Tree.

    - In-memory MemTable
    - Sorted immutable SSTables
    - Bloom filters
    - Tombstones
    - Prefix scan
    - Basic compaction
    """

    TOMBSTONE: ClassVar[dict[str, bool]] = {
        "__atlas_deleted__": True
    }

    def __init__(
        self,
        data_dir: str | Path,
        memtable_limit: int = 100,
        bloom_capacity: int = 1000,
    ) -> None:
        if not isinstance(memtable_limit, int) or isinstance(memtable_limit, bool):
            raise TypeError("memtable_limit must be an integer")

        if memtable_limit <= 0:
            raise ValueError("memtable_limit must be positive")

        self.data_dir = Path(data_dir)
        self.data_dir.mkdir(parents=True, exist_ok=True)

        self.memtable_limit = memtable_limit
        self.bloom_capacity = bloom_capacity

        self._memtable: dict[str, Any] = {}
        self._tables: list[tuple[Path, BloomFilter]] = []
        self._lock = threading.RLock()
        self._closed = False

        self._load_tables()

    @staticmethod
    def _validate_key(key: str) -> None:
        if not isinstance(key, str):
            raise TypeError("Key must be a string")
        if not key:
            raise ValueError("Key cannot be empty")

    def _ensure_open(self) -> None:
        if self._closed:
            raise RuntimeError("LSMTree is closed")

    @staticmethod
    def _is_tombstone(value: Any) -> bool:
        return isinstance(value, dict) and value == LSMTree.TOMBSTONE

    def _load_tables(self) -> None:
        paths = sorted(
            self.data_dir.glob("*.sst"),
            key=lambda path: int(path.stem),
            reverse=True,
        )

        for path in paths:
            bloom = BloomFilter(capacity=self.bloom_capacity)

            with path.open("r", encoding="utf-8") as file:
                for line in file:
                    if not line.strip():
                        continue
                    record = json.loads(line)
                    bloom.add(record["key"])

            self._tables.append((path, bloom))

    def put(self, key: str, value: Any) -> None:
        self._validate_key(key)
        json.dumps(value, allow_nan=False)

        with self._lock:
            self._ensure_open()
            self._memtable[key] = value

            if len(self._memtable) >= self.memtable_limit:
                self.flush()

    def delete(self, key: str) -> None:
        self._validate_key(key)

        with self._lock:
            self._ensure_open()
            self._memtable[key] = self.TOMBSTONE.copy()

            if len(self._memtable) >= self.memtable_limit:
                self.flush()

    def get(self, key: str) -> Any | None:
        self._validate_key(key)

        with self._lock:
            self._ensure_open()

            if key in self._memtable:
                value = self._memtable[key]
                return None if self._is_tombstone(value) else value

            for path, bloom in self._tables:
                if not bloom.might_contain(key):
                    continue

                value = self._search_table(path, key)

                if value is not _NOT_FOUND:
                    return None if self._is_tombstone(value) else value

            return None

    @staticmethod
    def _search_table(path: Path, key: str) -> Any:
        with path.open("r", encoding="utf-8") as file:
            for line in file:
                if not line.strip():
                    continue

                record = json.loads(line)
                current_key = record["key"]

                if current_key == key:
                    return record["value"]

                if current_key > key:
                    break

        return _NOT_FOUND

    def flush(self) -> Path | None:
        with self._lock:
            self._ensure_open()

            if not self._memtable:
                return None

            existing = [
                int(path.stem)
                for path in self.data_dir.glob("*.sst")
            ]

            table_id = max(existing, default=0) + 1
            final_path = self.data_dir / f"{table_id:020d}.sst"
            temporary_path = final_path.with_suffix(".tmp")

            bloom = BloomFilter(
                capacity=max(self.bloom_capacity, len(self._memtable))
            )

            try:
                with temporary_path.open("w", encoding="utf-8") as file:
                    for key in sorted(self._memtable):
                        value = self._memtable[key]

                        file.write(
                            json.dumps(
                                {"key": key, "value": value},
                                separators=(",", ":"),
                                ensure_ascii=False,
                                allow_nan=False,
                            ) + "\n"
                        )
                        bloom.add(key)

                    file.flush()

                temporary_path.replace(final_path)

            except Exception:
                temporary_path.unlink(missing_ok=True)
                raise

            self._tables.insert(0, (final_path, bloom))
            self._memtable.clear()

            return final_path

    def scan(self, prefix: str = "") -> dict[str, Any]:
        if not isinstance(prefix, str):
            raise TypeError("Prefix must be a string")

        with self._lock:
            self._ensure_open()

            keys = set(self._memtable)

            for path, _ in self._tables:
                with path.open("r", encoding="utf-8") as file:
                    for line in file:
                        if line.strip():
                            keys.add(json.loads(line)["key"])

            result = {}

            for key in sorted(keys):
                if key.startswith(prefix):
                    value = self.get(key)

                    if value is not None:
                        result[key] = value

            return result

    def compact(self) -> Path | None:
        with self._lock:
            self._ensure_open()

            if not self._tables:
                return self.flush()

            merged: dict[str, Any] = {}

            for path, _ in reversed(self._tables):
                with path.open("r", encoding="utf-8") as file:
                    for line in file:
                        if line.strip():
                            record = json.loads(line)
                            merged[record["key"]] = record["value"]

            merged.update(self._memtable)

            merged = {
                key: value
                for key, value in merged.items()
                if not self._is_tombstone(value)
            }

            table_id = max(
                (int(path.stem) for path in self.data_dir.glob("*.sst")),
                default=0,
            ) + 1

            old_tables = list(self._tables)
            final_path = self.data_dir / f"{table_id:020d}.sst"
            temporary_path = final_path.with_suffix(".tmp")

            bloom = BloomFilter(
                capacity=max(self.bloom_capacity, len(merged))
            )

            try:
                with temporary_path.open("w", encoding="utf-8") as file:
                    for key in sorted(merged):
                        file.write(
                            json.dumps(
                                {"key": key, "value": merged[key]},
                                separators=(",", ":"),
                                ensure_ascii=False,
                                allow_nan=False,
                            ) + "\n"
                        )
                        bloom.add(key)

                    file.flush()

                temporary_path.replace(final_path)

            except Exception:
                temporary_path.unlink(missing_ok=True)
                raise

            self._tables = [(final_path, bloom)]
            self._memtable.clear()

            for old_path, _ in old_tables:
                old_path.unlink(missing_ok=True)

            return final_path

    def close(self) -> None:
        with self._lock:
            if not self._closed:
                self.flush()
                self._closed = True

    def __enter__(self) -> Self:
        self._ensure_open()
        return self

    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None:
        self.close()
